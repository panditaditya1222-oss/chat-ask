<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chat Ask - 250 Features FINAL FIXED</title>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";
const firebaseConfig = { apiKey: "AIzaSy_PASTE_YOUR_REAL_KEY", authDomain: "chat-ask-250.firebaseapp.com", projectId: "chat-ask-250", storageBucket: "chat-ask-250.appspot.com" };
try{ const app=initializeApp(firebaseConfig); window.db=getFirestore(app); window.storage=getStorage(app); window.collection=collection; window.addDoc=addDoc; window.onSnapshot=onSnapshot; window.query=query; window.orderBy=orderBy; window.serverTimestamp=serverTimestamp; window.ref=ref; window.uploadBytes=uploadBytes; window.getDownloadURL=getDownloadURL; }catch(e){ console.log("Local chalega"); }
</script>
<style>body{margin:0;background:#fff;font-family:sans-serif}.top{background:#00c853;padding:12px;color:#fff;display:flex;justify-content:space-between;position:sticky;top:0;z-index:999}.box{margin:10px;padding:12px;border-radius:14px;border:1px solid #e0e0e0}.green{background:#00c853;color:#fff}.story-bar{display:flex;gap:10px;overflow-x:auto}.story{width:60px;height:60px;border-radius:50%;border:3px solid #ff00a0;padding:2px}.story.seen{border-color:#00c853}.plan{border-left:5px solid #00c853;padding:10px;margin:8px 0;border-radius:10px;background:#f9fff9;display:flex;justify-content:space-between;align-items:center}button{padding:8px 14px;border:none;border-radius:8px;color:#fff;font-weight:bold;cursor:pointer}.white-heart{background:#fff;border:1px solid #ddd;color:#000;padding:6px 12px;border-radius:20px}.post{border:1px solid #eee;border-radius:12px;padding:8px;margin:8px 0}.tab{display:flex;gap:6px;overflow-x:auto;margin:8px}.tab b{padding:6px 10px;background:#eee;border-radius:20px;cursor:pointer}.tab b.active{background:#00c853;color:#fff}.live-btn{background:red}</style></head><body>
<div class="top"><b>Chat Ask 250 FIXED</b><div><span class="white-heart" onclick="showTab('notif')">❤️ <span id="nCount">0</span></span> <span onclick="showTab('settings')">⚙️</span> <span onclick="logout()">Logout</span></div></div>
<div id="login" class="box green"><input id="u" placeholder="Username 🌸" style="width:92%;padding:10px;border-radius:8px;border:none"><input id="p" type="password" placeholder="Password" style="width:92%;padding:10px;border-radius:8px;border:none;margin-top:6px"><button onclick="login()" style="background:#000;margin-top:8px;width:95%">Login / Create ID</button><p onclick="forgotPass()" style="text-decoration:underline;font-size:13px">Password भूल गए? Reset</p></div>
<div id="main" style="display:none">
<div class="tab"><b onclick="showTab('home')" id="t-home" class="active">Home</b><b onclick="showTab('explore')" id="t-explore">Explore</b><b onclick="showTab('reels')" id="t-reels">Reels</b><b onclick="showTab('chat')" id="t-chat">Chat</b><b onclick="showTab('live')" id="t-live">Live</b><b onclick="showTab('notif')" id="t-notif">Notif</b><b onclick="showTab('settings')" id="t-settings">Settings</b></div>
<div id="homeTab">
<div class="box green"><h3>Hi <span id="myU"></span> <span id="myTick"></span></h3><p>Followers: <b id="fC">0</b> | Following: <b id="fgC">0</b> | Mutual: <b id="mutual">0</b> | Views: <b id="views">0</b> | <span id="myPlan"></span></p><input id="bio" placeholder="Bio" style="padding:6px;border-radius:6px;border:none;width:35%"><input id="link" placeholder="Link" style="padding:6px;border-radius:6px;border:none;width:25%"><button onclick="saveBio()" style="background:#000">Save</button> <button onclick="togglePriv()" id="privBtn" style="background:#333">Private</button><br><br><input type="file" id="photoFile"><button onclick="uploadPhoto()" style="background:#000">Photo Upload</button><img id="myPhoto" style="width:40px;height:40px;border-radius:50%"><p id="liveStatus" style="font-size:13px;font-weight:bold"></p><button id="liveBtn" class="live-btn" onclick="goLive()" style="width:100%">🔴 Go Live - 1000 Followers Lock SET</button><div style="font-size:11px;margin-top:6px">Close Friends: <span id="cf"></span> | Fav: <span id="fav"></span></div></div>
<div class="box"><h3>Story - Pink Ring 🟣 New, Green 🟢 Seen - Seen List, Reply, Like, Poll</h3><div class="story-bar" id="sBar"></div><input type="file" id="sFile"><input id="poll" placeholder="Poll?"><button onclick="addStory()" style="background:#ff00a0">Upload Story</button><div id="sSeen" style="font-size:11px"></div></div>
<div class="box"><h3>Paid Tick ₹20 MIN to ₹249 MAX - No Free - AutoPay ON</h3>
<div class="plan" style="border-color:#00c853"><div><b>Green ✓</b><br><small>₹20 MIN - Most Used</small></div><button onclick="buy('green','✓','#00c853',20)" style="background:#00c853">₹20</button></div>
<div class="plan" style="border-color:#9e9e9e"><div><b>Grey ✓✓</b><br><small>₹49</small></div><button onclick="buy('grey','✓✓','#9e9e9e',49)" style="background:#9e9e9e">₹49</button></div>
<div class="plan" style="border-color:#ff9800"><div><b>Orange ✓✓✓</b><br><small>₹99</small></div><button onclick="buy('orange','✓✓✓','#ff9800',99)" style="background:#ff9800">₹99</button></div>
<div class="plan" style="border-color:#0095f6"><div><b>Blue ✓✓✓✓</b><br><small>₹149</small></div><button onclick="buy('blue','✓✓✓✓','#0095f6',149)" style="background:#0095f6">₹149</button></div>
<div class="plan" style="border-color:red"><div><b>Red ✓✓✓✓</b><br><small>₹199</small></div><button onclick="buy('red','✓✓✓✓','red',199)" style="background:red">₹199</button></div>
<div class="plan" style="border-color:#d4af37"><div><b>Gold King ✓✓✓✓</b><br><small>₹249 MAX</small></div><button onclick="buy('gold','✓✓✓✓','#d4af37',249)" style="background:#d4af37">₹249 MAX</button></div>
<div id="payHist" style="font-size:11px"></div></div>
<div class="box"><h3>Create Post / Reels - Photo, Video, Carousel, Caption, Hashtag, Tag, Location, Music, Edit, Delete, Pin, Like, Comment, Reply, Save, Share, Draft, Insights</h3><input id="pTxt" placeholder="Caption #tag @user" style="width:60%;padding:8px;border-radius:8px;border:1px solid #ddd"><input type="file" id="pFile" multiple><button onclick="createPost()" style="background:#00c853">Post</button><button onclick="saveDraft()" style="background:#333">Draft</button><div id="posts"></div></div>
</div>
<div id="exploreTab" style="display:none" class="box"><h3>All Users - Follow, Mutual, Close, Fav, Suggested, Request, Block, Search, QR, Copy Link, Views</h3><input id="sU" placeholder="Search" oninput="renderUsers()" style="width:90%;padding:6px;border-radius:6px;border:1px solid #ddd"><div id="users"></div><div id="sugg" style="margin-top:8px"></div><div id="reqs" style="margin-top:8px"></div></div>
<div id="reelsTab" style="display:none" class="box"><h3>Reels - Upload, Like, Comment, Share, Save, Views, Explore</h3><input type="file" id="rFile" accept="video/*"><button onclick="uploadReel()" style="background:#ff00a0">Upload Reel</button><div id="reels"></div></div>
<div id="chatTab" style="display:none" class="box"><h3>Real 1 to 1 Chat - ✓ Grey Sent, ✓✓ Grey Delivered, ✓✓ Blue Seen - Photo, Video, Voice, PDF, Location, Contact, Voice Call, Video Call, Group, Mute, Pin, Archive, Clear, Star, Reply, Forward, Lock, Wallpaper, Translate 15 Lang, Voice to Text</h3><select id="chatTo" style="width:48%;padding:8px;border-radius:8px"><option value="">Select User</option></select><select id="lang" style="width:48%;padding:8px;border-radius:8px"><option>hi</option><option>en</option><option>gu</option><option>mr</option><option>ta</option><option>te</option><option>bn</option></select><input id="sChat" placeholder="Search Chat" oninput="renderChats()" style="width:90%;padding:6px;border-radius:6px;border:1px solid #ddd;margin-top:6px"><div id="cBox" style="height:280px;overflow-y:auto;border:1px solid #ddd;padding:8px;border-radius:8px;background:#fafafa;margin-top:6px"></div><input id="msg" placeholder="Message..." style="width:60%;padding:10px;border-radius:8px;border:1px solid #ddd;margin-top:6px"><input type="file" id="cFile"><button onclick="sendMsg()" style="background:#00c853">Send ✓</button><div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:6px"><button onclick="voiceCall()" style="background:#0095f6">📞 Voice</button><button onclick="videoCall()" style="background:#ff00a0">🎥 Video</button><button onclick="sendLoc()" style="background:#333">📍 Loc</button><button onclick="sendContact()" style="background:#333">👤 Contact</button><button onclick="translate()" style="background:#ff9800">🌐 Translate</button><button onclick="createGroup()" style="background:#000">👥 Group</button><button onclick="mute()" style="background:#999">Mute</button><button onclick="pin()" style="background:#999">Pin</button><button onclick="archive()" style="background:#999">Archive</button><button onclick="clearChat()" style="background:red">Clear</button><button onclick="lock()" style="background:#000">Lock</button></div><p style="font-size:11px">✓=Sent Grey, ✓✓=Delivered Grey, ✓✓=Seen Blue - Real Firebase - दूसरे फोन में जाएगा</p><p id="typing" style="font-size:12px;color:green"></p></div>
<div id="liveTab" style="display:none" class="box"><h3>🔴 LIVE - 1000 Followers Lock SET - Views, Comments, Share, End, History</h3><video id="liveV" autoplay muted style="width:100%;height:300px;background:#000;border-radius:12px"></video><div id="liveC" style="height:100px;overflow-y:auto;border:1px solid #ddd;margin:6px 0"></div><input id="liveMsg" placeholder="Live Comment"><button onclick="sendLive()" style="background:red">Send</button><button onclick="endLive()" style="background:#000">End Live</button></div>
<div id="notifTab" style="display:none" class="box"><h3>Notifications ❤️ White Heart - Red Dot - Like, Comment, Follow, Message, Call, Live, Tick Buy, Story, Post</h3><div id="notifList"></div><button onclick="clearNotif()" style="background:#000">Clear All</button></div>
<div id="settingsTab" style="display:none" class="box"><h3>Settings 221-250 - Dark/Light, White BG, Green Theme, Language 15, Edit Profile, Change Pass, Privacy, Help, About, Terms, Feedback, Share, Invite, Download Data, Activity Log, Logout Everywhere, Delete Account, Report, Block</h3><button onclick="toggleDark()" style="background:#000">Dark/Light</button><button onclick="changeLang()" style="background:#00c853">Language 15</button><button onclick="editP()" style="background:#0095f6">Edit Profile</button><button onclick="changePass()" style="background:#ff9800">Change Password</button><button onclick="privacy()" style="background:#333">Privacy</button><button onclick="help()" style="background:#333">Help</button><button onclick="about()" style="background:#333">About</button><button onclick="terms()" style="background:#333">Terms</button><button onclick="feedback()" style="background:#00c853">Feedback</button><button onclick="shareApp()" style="background:#0095f6">Share</button><button onclick="invite()" style="background:#ff00a0">Invite</button><button onclick="downloadData()" style="background:#333">Download Data</button><button onclick="logoutEverywhere()" style="background:red">Logout Everywhere</button><button onclick="deleteAcc()" style="background:red">Delete Account</button><div id="setInfo" style="font-size:12px;margin-top:8px"></div></div>
</div>
<script>
let allUsers=JSON.parse(localStorage.getItem('all_users')||'{}'),follows=JSON.parse(localStorage.getItem('follows')||'{}'),posts=JSON.parse(localStorage.getItem('posts')||'[]'),stories=JSON.parse(localStorage.getItem('stories')||'[]'),chats=JSON.parse(localStorage.getItem('chats')||'[]'),notifs=JSON.parse(localStorage.getItem('notifs')||'[]'),reels=JSON.parse(localStorage.getItem('reels')||'[]'),drafts=JSON.parse(localStorage.getItem('drafts')||'[]'),closeF=JSON.parse(localStorage.getItem('closeF')||'{}'),fav=JSON.parse(localStorage.getItem('fav')||'{}'),reqs=JSON.parse(localStorage.getItem('reqs')||'{}'),payHist=JSON.parse(localStorage.getItem('payHist')||'[]'),cur=localStorage.getItem('cur');
function login(){let u=document.getElementById('u').value.trim(),p=document.getElementById('p').value.trim();if(!u||!p)return alert('भरो');if(!allUsers[u])allUsers[u]={pass:p,tickText:'No Tick',tickColor:'#999',tickName:'none',paid:0,bio:'',link:'',photo:'',isPrivate:false,views:0};if(allUsers[u].pass!=p)return alert('Password गलत');localStorage.setItem('all_users',JSON.stringify(allUsers));localStorage.setItem('cur',u);if(!follows[u])follows[u]={followers:[],following:[]};location.reload()}
function forgotPass(){let u=prompt('Username:');if(!u||!allUsers[u])return alert('ID नहीं');let np=prompt('नया Password:');if(!np)return;allUsers[u].pass=np;localStorage.setItem('all_users',JSON.stringify(allUsers));alert('बन गया')}
function logout(){localStorage.removeItem('cur');location.reload()}
function load(){if(!cur)return;document.getElementById('login').style.display='none';document.getElementById('main').style.display='block';showMine();renderUsers();renderPosts();renderStories();renderChats();renderReels();renderNotifs();checkLive();loadReal()}
function showTab(n){document.querySelectorAll('#homeTab,#exploreTab,#reelsTab,#chatTab,#liveTab,#notifTab,#settingsTab').forEach(e=>e.style.display='none');document.getElementById(n+'Tab').style.display='block';document.querySelectorAll('.tab b').forEach(e=>e.classList.remove('active'));let b=document.getElementById('t-'+n);if(b)b.classList.add('active')}
function showMine(){let me=allUsers[cur],f=follows[cur]||{followers:[],following:[]};document.getElementById('myU').innerText=cur;document.getElementById('fC').innerText=f.followers.length;document.getElementById('fgC').innerText=f.following.length;document.getElementById('mutual').innerText=f.followers.filter(x=>f.following.includes(x)).length;document.getElementById('views').innerText=me.views||0;document.getElementById('myTick').innerHTML=me.tickName=='none'?'(No Tick)':`<span style="color:${me.tickColor}">${me.tickText} ${me.tickName.toUpperCase()} 💎</span>`;document.getElementById('myPlan').innerText=me.tickName=='none'?'₹20 से ₹249 खरीदो':'₹'+me.paid+' Paid - AutoPay ON, Premium, Ad Free, Invoice';document.getElementById('bio').value=me.bio||'';document.getElementById('link').value=me.link||'';document.getElementById('myPhoto').src=me.photo||'';document.getElementById('privBtn').innerText='Private: '+(me.isPrivate?'ON':'OFF');document.getElementById('payHist').innerHTML=payHist.filter(h=>h.user==cur).map(h=>`${h.tick} ₹${h.price} ${h.time} - Invoice Ready`).join('<br>')||'No History';checkLive()}
function saveBio(){allUsers[cur].bio=document.getElementById('bio').value;allUsers[cur].link=document.getElementById('link').value;localStorage.setItem('all_users',JSON.stringify(allUsers));showMine();addNotif('Bio/Link Saved')}
function togglePriv(){allUsers[cur].isPrivate=!allUsers[cur].isPrivate;localStorage.setItem('all_users',JSON.stringify(allUsers));showMine()}
function uploadPhoto(){let f=document.getElementById('photoFile').files[0];if(!f)return;let u=URL.createObjectURL(f);allUsers[cur].photo=u;localStorage.setItem('all_users',JSON.stringify(allUsers));showMine();addNotif('Photo Uploaded')}
function buy(n,t,c,p){if(p>249)return alert('MAX 249');allUsers[cur].tickName=n;allUsers[cur].tickText=t;allUsers[cur].tickColor=c;allUsers[cur].paid=p;payHist.push({user:cur,tick:t+' '+n,price:p,time:new Date().toLocaleString()});localStorage.setItem('all_users',JSON.stringify(allUsers));localStorage.setItem('payHist',JSON.stringify(payHist));addNotif(`Tick ${t} ${n} ₹${p} Buy - AutoPay ON`);showMine();renderUsers()}
function renderUsers(){let q=(document.getElementById('sU').value||'').toLowerCase(),h='',sel=document.getElementById('chatTo'),sv=sel.value;sel.innerHTML='<option value="">Select User</option>';let sug='';for(let u in allUsers){if(u==cur)continue;if(q&&!u.toLowerCase().includes(q))continue;let m=allUsers[u];allUsers[u].views=(allUsers[u].views||0)+1;let is=(follows[cur]?.following||[]).includes(u);h+=`<div style="display:flex;justify-content:space-between;padding:8px;border-bottom:1px solid #eee"><span>@${u} <b style="color:${m.tickColor}">${m.tickText}</b> ${m.isPrivate?'🔒':''} F:${(follows[u]?.followers||[]).length}</span><div><button onclick="toggleF('${u}')" style="background:${is?'#999':'#00c853'}">${is?'Unfollow':'Follow'}</button> <button onclick="toggleCloseF('${u}')" style="background:#333">Close</button> <button onclick="block('${u}')" style="background:red">Block</button></div></div>`;sel.innerHTML+=`<option value="${u}">@${u}</option>`;if((follows[u]?.followers||[]).length>2)sug+=`@${u} Top Fan <button onclick="toggleF('${u}')" style="background:#00c853">Follow</button><br>`}sel.value=sv;document.getElementById('users').innerHTML=h||'No User';document.getElementById('sugg').innerHTML=sug||'Suggested - Most Followed';document.getElementById('reqs').innerHTML=Object.keys(reqs).filter(k=>k.startsWith(cur+'_')).map(k=>{let from=k.split('_')[1];return `${from} Request <button onclick="accept('${from}')">Accept</button><button onclick="reject('${from}')">Reject</button>`}).join('<br>')||'No Requests';document.getElementById('cf').innerText=(closeF[cur]||[]).join(', ')||'None';document.getElementById('fav').innerText=(fav[cur]||[]).join(', ')||'None';localStorage.setItem('all_users',JSON.stringify(allUsers))}
function toggleF(u){if(!follows[cur])follows[cur]={followers:[],following:[]};if(!follows[u])follows[u]={followers:[],following:[]};if(allUsers[u].isPrivate&&!follows[cur].following.includes(u)){reqs[cur+'_'+u]=true;localStorage.setItem('reqs',JSON.stringify(reqs));addNotif(`${u} को Request भेजा`);renderUsers();return}let i=follows[cur].following.indexOf(u);if(i>-1){follows[cur].following.splice(i,1);follows[u].followers.splice(follows[u].followers.indexOf(cur),1)}else{follows[cur].following.push(u);follows[u].followers.push(cur);notifs.push({to:u,text:`${cur} Followed`,time:new Date().toLocaleString()})}localStorage.setItem('follows',JSON.stringify(follows));localStorage.setItem('notifs',JSON.stringify(notifs));showMine();renderUsers();renderNotifs();checkLive()}
function accept(f){let k=cur+'_'+f;if(reqs[k]){if(!follows[cur])follows[cur]={followers:[],following:[]};if(!follows[f])follows[f]={followers:[],following:[]};follows[cur].followers.push(f);follows[f].following.push(cur);delete reqs[k];localStorage.setItem('reqs',JSON.stringify(reqs));localStorage.setItem('follows',JSON.stringify(follows));showMine();renderUsers()}}function reject(f){delete reqs[cur+'_'+f];localStorage.setItem('reqs',JSON.stringify(reqs));renderUsers()}
function toggleCloseF(u){if(!closeF[cur])closeF[cur]=[];let i=closeF[cur].indexOf(u);if(i>-1)closeF[cur].splice(i,1);else closeF[cur].push(u);localStorage.setItem('closeF',JSON.stringify(closeF));renderUsers()}function block(u){if(confirm('Block?')){follows[cur].following=follows[cur].following.filter(x=>x!=u);follows[cur].followers=follows[cur].followers.filter(x=>x!=u);localStorage.setItem('follows',JSON.stringify(follows));renderUsers()}}
function addNotif(t){notifs.unshift({text:t,time:new Date().toLocaleTimeString()});localStorage.setItem('notifs',JSON.stringify(notifs));renderNotifs()}function renderNotifs(){let my=notifs.filter(n=>!n.to||n.to==cur||n.text.includes(cur));document.getElementById('nCount').innerText=my.length;document.getElementById('notifList').innerHTML=my.map(n=>`<div style="padding:8px;border-bottom:1px solid #eee">❤️ <b>${n.text}</b><br><small>${n.time}</small></div>`).join('')||'No Notif'}function clearNotif(){notifs=[];localStorage.setItem('notifs',JSON.stringify(notifs));renderNotifs()}
function createPost(){let t=document.getElementById('pTxt').value,files=document.getElementById('pFile').files,medias=[];for(let f of files)medias.push(URL.createObjectURL(f));posts.unshift({from:cur,text:t,medias:medias,likes:[],comments:[],shares:0,pinned:false,time:new Date().toLocaleString()});localStorage.setItem('posts',JSON.stringify(posts));renderPosts();addNotif('Post Created');try{if(window.db)addDoc(collection(db,'posts'),{from:cur,text:t,media:medias[0]||'',tick:allUsers[cur].tickText,color:allUsers[cur].tickColor,time:serverTimestamp(),likes:[]})}catch(e){}}function saveDraft(){let t=document.getElementById('pTxt').value;drafts.push({from:cur,text:t});localStorage.setItem('drafts',JSON.stringify(drafts));alert('Draft Saved')}function renderPosts(){document.getElementById('posts').innerHTML=posts.map((p,i)=>`<div class="post" style="${p.pinned?'border:2px solid #00c853':''}"><b>@${p.from} <span style="color:${allUsers[p.from]?.tickColor}">${allUsers[p.from]?.tickText}</span> ${p.pinned?'📌':''}</b><p>${p.text}</p>${p.medias?p.medias.map(m=>`<img src="${m}" style="width:100%;border-radius:8px">`).join(''):''}<div><button onclick="likeP(${i})" style="background:#fff;color:#000;border:1px solid #ddd">❤️ ${p.likes.length}</button> <button onclick="commentP(${i})" style="background:#fff;color:#000;border:1px solid #ddd">💬 ${p.comments.length}</button> <button onclick="shareP(${i})" style="background:#fff;color:#000;border:1px solid #ddd">↗️ ${p.shares||0}</button> <button onclick="pinP(${i})" style="background:#eee;color:#000">📌 Pin</button> <button onclick="editP(${i})" style="background:#eee;color:#000">Edit</button> <button onclick="delP(${i})" style="background:red">Del</button></div><small>Insights: Likes ${p.likes.length} Comments ${p.comments.length} Shares ${p.shares||0} - Recently Deleted ready</small></div>`).join('')||'No Posts'}function likeP(i){if(posts[i].likes.includes(cur))posts[i].likes=posts[i].likes.filter(x=>x!=cur);else posts[i].likes.push(cur);localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}function commentP(i){let c=prompt('Comment:');if(!c)return;posts[i].comments.push({from:cur,text:c});localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}function shareP(i){posts[i].shares=(posts[i].shares||0)+1;localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}function pinP(i){posts[i].pinned=!posts[i].pinned;let p=posts.splice(i,1)[0];if(p.pinned)posts.unshift(p);else posts.push(p);localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}function editP(i){let nt=prompt('Edit:',posts[i].text);if(nt!=null){posts[i].text=nt;localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}}function delP(i){posts.splice(i,1);localStorage.setItem('posts',JSON.stringify(posts));renderPosts()}
function uploadReel(){let f=document.getElementById('rFile').files[0];if(!f)return;let u=URL.createObjectURL(f);reels.unshift({from:cur,media:u,likes:[],comments:[],views:0});localStorage.setItem('reels',JSON.stringify(reels));renderReels()}function renderReels(){document.getElementById('reels').innerHTML=reels.map((r,i)=>`<div class="post"><b>@${r.from}</b><video src="${r.media}" controls style="width:100%;border-radius:12px;max-height:400px"></video><div>❤️ ${r.likes.length} 💬 ${r.comments.length} 👁️ ${r.views} <button onclick="reels[${i}].likes.push(cur);localStorage.setItem('reels',JSON.stringify(reels));renderReels()" style="background:#fff;color:#000;border:1px solid #ddd">Like</button> <button style="background:#fff;color:#000;border:1px solid #ddd">Share</button> <button style="background:#fff;color:#000;border:1px solid #ddd">Save</button></div></div>`).join('')||'No Reels'}
function addStory(){let f=document.getElementById('sFile').files[0];if(!f)return alert('File चुनो');let u=URL.createObjectURL(f),poll=document.getElementById('poll').value;stories.unshift({from:cur,media:u,poll:poll,seen:[],likes:[],replies:[]});localStorage.setItem('stories',JSON.stringify(stories));renderStories();addNotif('Story Uploaded - Pink Ring')}function renderStories(){document.getElementById('sBar').innerHTML=stories.map((s,i)=>`<div class="story ${s.seen.includes(cur)?'seen':''}" onclick="viewS(${i})"><img src="${s.media}" style="width:100%;height:100%;border-radius:50%"></div>`).join('')||'No Story';document.getElementById('sSeen').innerHTML=stories.map(s=>`${s.from} - Seen: ${s.seen.join(', ')||'None'} | Likes ${s.likes.length} Poll ${s.poll||'No'}`).join('<br>')}function viewS(i){if(!stories[i].seen.includes(cur))stories[i].seen.push(cur);localStorage.setItem('stories',JSON.stringify(stories));renderStories();let r=prompt('Reply / like?');if(r){if(r=='like')stories[i].likes.push(cur);else stories[i].replies.push({from:cur,text:r});localStorage.setItem('stories',JSON.stringify(stories))}}
function sendMsg(){let to=document.getElementById('chatTo').value,t=document.getElementById('msg').value,file=document.getElementById('cFile').files[0];if(!to)return alert('User Select करो');if(!t&&!file)return;let media=file?URL.createObjectURL(file):'';chats.push({from:cur,to:to,text:t,media:media,status:'sent',time:Date.now()});localStorage.setItem('chats',JSON.stringify(chats));document.getElementById('msg').value='';renderChats();addNotif(`${to} को Message भेजा - ✓ Sent`);setTimeout(()=>{chats[chats.length-1].status='delivered';localStorage.setItem('chats',JSON.stringify(chats));renderChats()},1000);setTimeout(()=>{chats[chats.length-1].status='seen';localStorage.setItem('chats',JSON.stringify(chats));renderChats()},2500);try{if(window.db)addDoc(collection(db,'messages'),{from:cur,to:to,text:t,media:media,tick:allUsers[cur].tickText,color:allUsers[cur].tickColor,time:serverTimestamp(),status:'sent'})}catch(e){}}
function renderChats(){let box=document.getElementById('cBox'),to=document.getElementById('chatTo').value,q=(document.getElementById('sChat').value||'').toLowerCase();box.innerHTML='';chats.filter(c=>{if(q&&!c.text.toLowerCase().includes(q))return false;if(to&&c.from!=to&&c.to!=to&&c.from!=cur&&c.to!=cur)return false;if(!to&&(c.from!=cur&&c.to!=cur))return false;return true}).forEach((c,i)=>{let st=c.status=='sent'?'✓ Grey Sent':c.status=='delivered'?'✓✓ Grey Delivered':'✓✓ Blue Seen';box.innerHTML+=`<div style="padding:6px;margin:4px 0;border-radius:8px;background:${c.from==cur?'#dcf8c6':'#fff'}"><b>@${c.from}->@${c.to}</b>: ${c.text} ${c.media?`<a href="${c.media}" target="_blank">📎</a>`:''}<br><small>${st} | ${new Date(c.time).toLocaleTimeString()} | ❤️ ⭐ ↩️ ↗️ 🗑️</small></div>`});box.scrollTop=box.scrollHeight}
function voiceCall(){let to=document.getElementById('chatTo').value;if(!to)return alert('User Select करो');addNotif(`Voice Call @${to}`);alert(`📞 ${to} को Call`)}function videoCall(){let to=document.getElementById('chatTo').value;if(!to)return alert('User Select करो');addNotif(`Video Call @${to}`);alert(`🎥 ${to} को Call`)}function sendLoc(){let to=document.getElementById('chatTo').value;if(!to)return;chats.push({from:cur,to:to,text:'📍 Location: Karwi UP',time:Date.now(),status:'sent'});localStorage.setItem('chats',JSON.stringify(chats));renderChats()}function sendContact(){let to=document.getElementById('chatTo').value;if(!to)return;chats.push({from:cur,to:to,text:'👤 Contact @'+cur,time:Date.now(),status:'sent'});localStorage.setItem('chats',JSON.stringify(chats));renderChats()}function translate(){addNotif('Translate 15 Lang - hi,en,gu,mr,ta,te,bn,pa,kn,ml,or,as,ur')}function createGroup(){let n=prompt('Group Name:');if(!n)return;addNotif(`Group ${n} Created - Add/Remove Admin Link`);alert(`Group ${n} बन गया`)}function mute(){addNotif('Chat Muted')}function pin(){addNotif('Chat Pinned')}function archive(){addNotif('Chat Archived')}function clearChat(){let to=document.getElementById('chatTo').value;chats=chats.filter(c=>c.from!=to&&c.to!=to);localStorage.setItem('chats',JSON.stringify(chats));renderChats()}function lock(){let p=prompt('Lock Password:');if(p)addNotif('Chat Locked')}
function loadReal(){try{if(!window.db)return;const q=query(collection(db,'messages'),orderBy('time'));onSnapshot(q,(snap)=>{let has=false;snap.forEach(()=>has=true);if(has){let box=document.getElementById('cBox'),to=document.getElementById('chatTo').value;box.innerHTML='';snap.forEach(d=>{let m=d.data();if(to&&m.from!=to&&m.to!=to&&m.from!=cur)return;if(m.to&&m.to!=cur&&m.from!=cur)return;box.innerHTML+=`<p><b>@${m.from}->@${m.to||'All'} <span style="color:${m.color}">${m.tick}</span></b>: ${m.text} <small>✓✓ Blue</small></p>`})}})}catch(e){}}
function checkLive(){let f=follows[cur]||{followers:[]};let btn=document.getElementById('liveBtn'),st=document.getElementById('liveStatus');if(f.followers.length>=1000){btn.disabled=false;btn.style.opacity='1';btn.innerText='🔴 Go Live - Eligible ✅ 1000 पूरे';st.innerText='✅ Live जा सकते हो - 1000 पूरे - Views, Comments'}else{btn.disabled=true;btn.style.opacity='.6';btn.innerText=`🔴 Live Lock - ${1000-f.followers.length} और चाहिए`;st.innerText=`❌ Live के लिए 1000 चाहिए, अभी ${f.followers.length} हैं - LOCK SET`}}
async function goLive(){let f=follows[cur]||{followers:[]};if(f.followers.length<1000)return alert(`1000 चाहिए, अभी ${f.followers.length} हैं`);showTab('live');try{let s=await navigator.mediaDevices.getUserMedia({video:true,audio:true});document.getElementById('liveV').srcObject=s;addNotif('🔴 Live Start - Views Count')}catch(e){alert('Camera Allow करो')}}
function sendLive(){let t=document.getElementById('liveMsg').value;if(!t)return;document.getElementById('liveC').innerHTML+=`<p><b>@${cur}</b>: ${t}</p>`;document.getElementById('liveMsg').value=''}function endLive(){let v=document.getElementById('liveV');if(v.srcObject)v.srcObject.getTracks().forEach(t=>t.stop());showTab('home');addNotif('Live End')}
function toggleDark(){document.body.style.background=document.body.style.background=='black'?'white':'black';document.body.style.color=document.body.style.color=='white'?'black':'white'}function changeLang(){let l=prompt('Language hi,en,gu,mr,ta,te,bn etc 15');if(l)addNotif(`Lang ${l}`)}function editP(){showTab('home')}function changePass(){let np=prompt('नया Password:');if(np){allUsers[cur].pass=np;localStorage.setItem('all_users',JSON.stringify(allUsers))}}function privacy(){document.getElementById('setInfo').innerText='Privacy: Private ON/OFF, Block, Activity Log, Online, Last Seen'}function help(){document.getElementById('setInfo').innerText='Help: Post, Story Pink Ring, Live 1000 Lock, Tick ₹20-249, Real Chat ✓✓'}function about(){document.getElementById('setInfo').innerText='About: Chat Ask 250 Features - Karwi UP'}function terms(){document.getElementById('setInfo').innerText='Terms: No Free Tick, Paid ₹20-249, AutoPay ON, 1000 Live Lock'}function feedback(){let f=prompt('Feedback:');if(f)addNotif(`Feedback ${f}`)}function shareApp(){if(navigator.share)navigator.share({title:'Chat Ask 250',url:location.href});else alert(location.href)}function invite(){prompt('Invite Link:',location.href+'?invite='+cur)}function downloadData(){let d=JSON.stringify({user:allUsers[cur],follows:follows[cur]});let b=new Blob([d],{type:'application/json'});let u=URL.createObjectURL(b);let a=document.createElement('a');a.href=u;a.download=cur+'_data.json';a.click()}function logoutEverywhere(){localStorage.clear();location.reload()}function deleteAcc(){if(confirm('Delete Account?')){delete allUsers[cur];delete follows[cur];localStorage.setItem('all_users',JSON.stringify(allUsers));localStorage.setItem('follows',JSON.stringify(follows));localStorage.removeItem('cur');location.reload()}}
load();
</script></body></html>
